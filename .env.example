PORT=3001
HOST=127.0.0.1
CROWN_DB=./data/crown.sqlite
# Desactiva las cuentas demo y el reloj administrativo fuera del entorno local.
CROWN_DEMO=true
CROWN_ADMIN_TOOLS=true
# Producción: cookies seguras detrás de HTTPS.
COOKIE_SECURE=false
# Modo auth opcional: local | supabase (requiere backend desplegado).
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_API_URL=
PUBLIC_ORIGIN=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Pages Function (configurar en Pages, no hace falta en local)
CROWN_API_ORIGIN=
