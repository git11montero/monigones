{
  "name": "monigones",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --import tsx --watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:api": "node --import tsx --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "simulate": "node --import tsx scripts/simulate.ts",
    "check": "tsc --noEmit && npm run check:online",
    "catalogs": "node --import tsx scripts/export-catalogs.ts && node --import tsx scripts/export-sql.ts",
    "sports:validate": "node --import tsx scripts/import-sports.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sports:assets": "node --import tsx scripts/sports-media.ts",
    "sports:assets:import": "node --import tsx scripts/sports-media.ts",
    "images:prepare": "node --import tsx scripts/football-images.ts --prepare",
    "images:validate": "node --import tsx scripts/football-images.ts",
    "build:online": "node scripts/build-online.mjs",
    "images:manifest": "node --import tsx scripts/football-manifest.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "check:online": "tsc --project tsconfig.online.json",
    "test:vercel-artifact": "node scripts/test-vercel-artifact.mjs",
    "verify:vercel": "npx vercel build --prod && npm run test:vercel-artifact",
    "seed:online-demo": "node --import tsx scripts/seed-online-demo.ts",
    "export:local-demo": "node --import tsx scripts/export-local-demo.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@supabase/supabase-js": "^2.76.0",
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^26.1.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
